{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/image/compcard.png",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Lina_Comp_Card.png\""
        }
      ]
    },
    {
      "source": "/portfolio-config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
